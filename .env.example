# Express Server Configuration
PORT=3000
HOST=127.0.0.1

# Redis Configuration
REDIS_URL=redis://localhost:6379

# OpenTelemetry Exporter Configuration
# Local Self-Hosted SigNoz (Default)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_HEADERS=
# OTEL_EXPORTER_OTLP_TIMEOUT=5000

# SigNoz Cloud (Uncomment and replace <region> with us, eu, or in)
# OTEL_EXPORTER_OTLP_ENDPOINT=https://ingest.<region>.signoz.cloud:443
# OTEL_EXPORTER_OTLP_HEADERS=signoz-ingestion-key=<your-signoz-ingestion-key>

# Worker Configuration (integer between 1 and 50)
WORKER_CONCURRENCY=5
