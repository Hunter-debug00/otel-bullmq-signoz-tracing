# Express Server Configuration
PORT=3000
HOST=0.0.0.0

# Redis Configuration
REDIS_URL=redis://localhost:6379

# OpenTelemetry Exporter Configuration
# Note: OTEL_EXPORTER_OTLP_ENDPOINT is the base HTTP endpoint (e.g. http://localhost:4318).
# Exporters append /v1/traces and /v1/metrics automatically.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Optional OTLP Headers (comma-separated key=value pairs for SigNoz Cloud or authenticated endpoints)
# Example for SigNoz Cloud:
# OTEL_EXPORTER_OTLP_HEADERS=signoz-access-token=your-ingestion-key

# Worker Configuration (integer between 1 and 50)
WORKER_CONCURRENCY=5
